+const char *LtvReadiness::updateWindow(const LtvReadinessInput &i, LtvReadinessOutput &o, bool hard) {
+  auto reject = [&](const char *reason) {
+    clearWindow();
+    gravity_frames_ = velocity_frames_ = 0;
+    return reason;
+  };
+  if (!hard) return reject("window_shared_hard_failure");
+  if (!i.window_transition_valid || i.window_transition_version != 1 || !std::isfinite(i.window_from) ||
+      !std::isfinite(i.window_to) || i.window_to != i.time || i.window_from > i.window_to)
+    return reject("window_transition_invalid");
+  for (double x : i.window_phi) if (!std::isfinite(x)) return reject("window_transition_nonfinite");
+  for (double x : i.window_delta) if (!std::isfinite(x)) return reject("window_delta_nonfinite");
+  if (window_anchor_ >= 0 && (i.window_epoch != window_epoch_ || i.window_from != window_cursor_))
+    return reject("window_transition_identity_mismatch");
+  if (window_anchor_ < 0) {
+    window_anchor_ = i.time;
+    window_epoch_ = i.window_epoch;
+    window_cursor_ = i.time;
+  }
+  const double left = i.time - 1.0;
+  size_t keep = 0;
+  for (size_t j = 0; j < window_size_; ++j)
+    if (window_[j].to > left) window_[keep++] = window_[j];
+  window_size_ = keep;
+  if (window_size_ == window_.size()) return reject("window_capacity_exceeded");
+  for (size_t j = 0; j < window_size_; ++j) {
+    std::array<double, 6> value{};
+    for (size_t r = 0; r < 6; ++r)
+      for (size_t c = 0; c < 6; ++c) value[r] += i.window_phi[6*r+c] * window_[j].transported[c];
+    for (double x : value) if (!std::isfinite(x)) return reject("window_transport_nonfinite");
+    window_[j].transported = value;
+  }
+  auto norm = [](const std::array<double, 6> &x, size_t offset) {
+    return std::hypot(std::hypot(x[offset], x[offset+1]), x[offset+2]);
+  };
+  WindowEntry entry;
+  entry.from = window_cursor_;
+  entry.to = i.time;
+  entry.angle = i.prediction_angle_p95_rad;
+  entry.transported = i.window_delta;
+  entry.impulse_V = norm(i.window_delta, 0);
+  entry.impulse_G = norm(i.window_delta, 3);
+  window_[window_size_++] = entry;
+  window_cursor_ = i.time;
+  o.window_samples = static_cast<unsigned>(window_size_);
+  o.window_coverage = i.time - window_anchor_;
+  const bool complete = o.window_coverage >= 1.0;
+  long double weight = 0, angle = 0, activity_v = 0, activity_g = 0;
+  std::array<long double, 6> sum{};
+  double covered_to = std::max(left, window_anchor_);
+  for (size_t j = 0; j < window_size_; ++j) {
+    const auto &e = window_[j];
+    const double a = std::max(e.from, left), b = std::min(e.to, i.time);
+    if (b > a) {
+      if (a != covered_to) return reject("window_uncovered_interval");
+      covered_to = b;
+      const long double w = static_cast<long double>(b) - static_cast<long double>(a);
+      weight += w; angle += w * e.angle;
+    }
+    if (e.to > left) {
+      for (size_t k = 0; k < 6; ++k) sum[k] += e.transported[k];
+      activity_v += norm(e.transported, 0); activity_g += norm(e.transported, 3);
+      o.window_impulse_V = std::max(o.window_impulse_V, e.impulse_V);
+      o.window_impulse_G = std::max(o.window_impulse_G, e.impulse_G);
+    }
+  }
+  if (complete && covered_to != i.time) return reject("window_uncovered_interval");
+  o.window_complete = complete;
+  o.window_coverage = std::min(o.window_coverage, 1.0);
+  o.window_angle_mean = weight > 0 ? static_cast<double>(angle / weight) : 0;
+  o.window_net_V = static_cast<double>(std::sqrt(sum[0]*sum[0]+sum[1]*sum[1]+sum[2]*sum[2]));
+  o.window_net_G = static_cast<double>(std::sqrt(sum[3]*sum[3]+sum[4]*sum[4]+sum[5]*sum[5]));
+  o.window_activity_V = static_cast<double>(activity_v);
+  o.window_activity_G = static_cast<double>(activity_g);
+  for (double x : {o.window_net_V, o.window_net_G, o.window_activity_V, o.window_activity_G,
+                   o.window_impulse_V, o.window_impulse_G, o.window_angle_mean})
+    if (!std::isfinite(x)) return reject("window_aggregate_nonfinite");
+  const bool good_G = complete && o.window_angle_mean <= .02 && o.window_net_G <= 1.0 &&
+      o.window_activity_G <= 2.0 && o.window_impulse_G <= 1.0;
+  const bool good_V = good_G && o.window_net_V <= .5 && o.window_activity_V <= 1.0 && o.window_impulse_V <= .5;
+  gravity_frames_ = good_G ? std::min(gravity_frames_ + 1, config_.ready_confirm_frames) : 0;
+  velocity_frames_ = good_V ? std::min(velocity_frames_ + 1, config_.ready_confirm_frames) : 0;
+  o.window_confirmation_G = gravity_frames_; o.window_confirmation_V = velocity_frames_;
+  o.ready_G = gravity_frames_ >= config_.ready_confirm_frames;
+  o.ready_V = velocity_frames_ >= config_.ready_confirm_frames;
+  return !complete ? "window_filling" : !good_G ? "window_gravity_budget" : !good_V ? "window_velocity_budget" :
+      !(o.ready_G && o.ready_V) ? "window_confirming" : "ready";
+}
